			iommus = <0x34 0x1020 0x00 0x34 0x1021 0x00 0x34 0x1032 0x00>;
			power-domains = <0xdf 0x00>;
			required-opps = <0x23>;
			status = "disabled";
			clocks = <0x32 0x83 0xe0 0x06 0xe0 0x07 0xe0 0x0a 0xe0 0x08 0xe0 0x09>;
			clock-names = "pcnoc-sway-clk", "audio-core", "mclk0", "pcnoc-mport-clk", "mi2s-bit-clk0", "mi2s-bit-clk1";
			#sound-dai-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0xa0 0x04 0x00 0x10c 0x04>;
			interrupt-names = "lpass-irq-lpaif", "lpass-irq-hdmi";
		};

		clock-controller@63000000 {
			compatible = "qcom,sc7180-lpasshm";
			reg = <0x00 0x63000000 0x00 0x28>;
			clocks = <0x32 0x83 0x2f 0x00>;
			clock-names = "iface", "bi_tcxo";
			power-domains = <0x31 0x00>;
			#clock-cells = <0x01>;
			#power-domain-cells = <0x01>;
			status = "reserved";
			phandle = <0xdf>;
		};

		codec@62640000 {
			compatible = "qcom,sm8250-lpass-wsa-macro";
			reg = <0x00 0x62640000 0x00 0x1000>;
			status = "disabled";
			clocks = <0xe1 0x01 0xe1 0x00 0xe2 0x66 0x01 0xe2 0x67 0x01 0xe3 0x00 0xe4>;
			clock-names = "mclk", "npl", "macro", "dcodec", "va", "fsgen";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "mclk";
			#sound-dai-cells = <0x01>;
			pinctrl-names = "default";
			pinctrl-0 = <0xe5>;
			phandle = <0xe6>;
		};

		soundwire-controller@62650000 {
			reg = <0x00 0x62650000 0x00 0x2000>;
			compatible = "qcom,soundwire-v1.5.1";
			status = "disabled";
			interrupts = <0x00 0x127 0x04>;
			clocks = <0xe6>;
			clock-names = "iface";
			qcom,din-ports = <0x02>;
			qcom,dout-ports = <0x06>;
			qcom,ports-sinterval-low = <0x71f3f07 0x1f3f0f0f>;
			qcom,ports-offset1 = <0x1020c06 0x120d070a>;
			qcom,ports-offset2 = <0xff001fff 0x1f0000>;
			qcom,ports-block-pack-mode = <0x100 0x10000>;
			#sound-dai-cells = <0x01>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
		};

		clock-controller@62700000 {
			compatible = "qcom,sm8250-lpass-audiocc";
			reg = <0x00 0x62700000 0x00 0x30000>;
			#clock-cells = <0x01>;
			clocks = <0xe2 0x66 0x01 0xe2 0x67 0x01 0xe2 0x39 0x01>;
			clock-names = "core", "audio", "bus";
			phandle = <0xe1>;
		};

		codec@62770000 {
			compatible = "qcom,sm8250-lpass-va-macro";
			reg = <0x00 0x62770000 0x00 0x1000>;
			status = "okay";
			clocks = <0xe3 0x00 0xe2 0x66 0x01 0xe2 0x67 0x01>;
			clock-names = "mclk", "macro", "dcodec";
			#clock-cells = <0x00>;
			clock-frequency = <0x927c00>;
			clock-output-names = "fsgen";
			#sound-dai-cells = <0x01>;
