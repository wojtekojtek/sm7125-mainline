			compatible = "qcom,sc7180-adsp-pas";
			reg = <0x00 0x62400000 0x00 0x100>;
			interrupts-extended = <0x01 0x00 0xa2 0x01 0xdc 0x00 0x01 0xdc 0x01 0x01 0xdc 0x02 0x01 0xdc 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x2f 0x00>;
