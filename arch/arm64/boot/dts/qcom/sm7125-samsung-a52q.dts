			phandle = <0xe4>;
		};

		rxmacro@62600000 {
			pinctrl-names = "default";
			pinctrl-0 = <0xe7>;
			compatible = "qcom,sm8250-lpass-rx-macro";
			reg = <0x00 0x62600000 0x00 0x1000>;
			status = "okay";
			clocks = <0xe2 0x39 0x01 0xe2 0x3a 0x01 0xe2 0x66 0x01 0xe2 0x67 0x01 0xe4>;
			clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
			#clock-cells = <0x00>;
			clock-frequency = <0x927c00>;
			clock-output-names = "mclk";
			#sound-dai-cells = <0x01>;
			phandle = <0xe8>;
		};

		soundwire-controller@62610000 {
			reg = <0x00 0x62610000 0x00 0x2000>;
			compatible = "qcom,soundwire-v1.5.1";
			status = "okay";
			interrupts = <0x00 0x129 0x04>;
			clocks = <0xe8>;
			clock-names = "iface";
			label = "RX";
			qcom,din-ports = <0x00>;
			qcom,dout-ports = <0x05>;
			qcom,ports-sinterval-low = [03 1f 1f 07 00];
			qcom,ports-offset1 = [00 00 0b 01 00];
			qcom,ports-offset2 = [00 00 0b 00 00];
			qcom,ports-hstart = [ff 03 ff ff ff];
			qcom,ports-hstop = [ff 06 ff ff ff];
			qcom,ports-word-length = [01 07 04 ff ff];
			qcom,ports-block-pack-mode = [ff 00 01 ff ff];
			qcom,ports-block-group-count = [ff ff ff ff 00];
			qcom,ports-lane-control = [01 00 00 00 00];
			#sound-dai-cells = <0x01>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			phandle = <0xf3>;

			wcd9380-rx@0,4 {
				compatible = "sdw20217010d00";
				reg = <0x00 0x04>;
				qcom,rx-port-mapping = <0x01 0x02 0x03 0x04 0x05>;
				phandle = <0x117>;
			};
		};

		txmacro@62620000 {
			pinctrl-names = "default";
			pinctrl-0 = <0xe9>;
			compatible = "qcom,sm8250-lpass-tx-macro";
			reg = <0x00 0x62620000 0x00 0x1000>;
			status = "okay";
			clocks = <0xe2 0x39 0x01 0xe2 0x3a 0x01 0xe2 0x66 0x01 0xe2 0x67 0x01 0xe4>;
			clock-names = "mclk", "npl", "macro", "dcodec", "fsgen";
			#clock-cells = <0x00>;
			clock-frequency = <0x927c00>;
			clock-output-names = "mclk";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			#sound-dai-cells = <0x01>;
			phandle = <0xea>;
		};

		soundwire-controller@62630000 {
			reg = <0x00 0x62630000 0x00 0x2000>;
			compatible = "qcom,soundwire-v1.5.1";
			status = "okay";
			interrupts = <0x00 0x128 0x04>;
			clocks = <0xea>;
			clock-names = "iface";
			label = "TX";
			qcom,din-ports = <0x05>;
			qcom,dout-ports = <0x00>;
			qcom,ports-sinterval-low = [ff 01 01 03 03];
			qcom,ports-offset1 = [ff 01 00 02 00];
			qcom,ports-offset2 = [ff 00 00 00 00];
			qcom,ports-block-pack-mode = [ff ff ff ff ff];
			qcom,ports-hstart = [ff ff ff ff ff];
			qcom,ports-hstop = [ff ff ff ff ff];
			qcom,ports-word-length = [ff ff ff ff ff];
			qcom,ports-block-group-count = [ff ff ff ff ff];
			qcom,ports-lane-control = [ff 00 01 00 01];
			qcom,port-offset = <0x01>;
			#sound-dai-cells = <0x01>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			phandle = <0xf4>;

			wcd9380-tx@0,3 {
				compatible = "sdw20217010d00";
				reg = <0x00 0x03>;
				qcom,tx-port-mapping = <0x02 0x03 0x04 0x05>;
				phandle = <0x118>;
			};
		};

		clock-controller@62780000 {
			compatible = "qcom,sm8250-lpass-aoncc";
			reg = <0x00 0x62780000 0x00 0x40000>;
			#clock-cells = <0x01>;
			clocks = <0xe2 0x66 0x01 0xe2 0x67 0x01 0xe2 0x3a 0x01>;
			clock-names = "core", "audio", "bus";
			phandle = <0xe3>;
		};

		pinctrl@627c0000 {
			compatible = "qcom,sm7125-lpass-lpi-pinctrl", "qcom,sc7280-lpass-lpi-pinctrl";
			reg = <0x00 0x627c0000 0x00 0x20000 0x00 0x62950000 0x00 0x10000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0xeb 0x00 0x00 0x0f>;
			clocks = <0xe2 0x66 0x01 0xe2 0x67 0x01>;
			clock-names = "core", "audio";
			phandle = <0xeb>;

			i2s1-active-pins {
				phandle = <0xec>;

				clk {
					pins = "gpio6";
					function = "i2s1_clk";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};

				ws {
					pins = "gpio7";
					function = "i2s1_ws";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};

				data {
					pins = "gpio8", "gpio9";
					function = "i2s1_data";
					drive-strength = <0x08>;
					bias-disable;
					output-high;
				};
			};

			wsa-swr-active-pins {
				phandle = <0xe5>;

				clk {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-disable;
				};

				data {
					pins = "gpio11";
					function = "wsa_swr_data";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-bus-hold;
				};
			};

			rx_swr-active-pins {
				phandle = <0xe7>;

				clk {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-disable;
				};

				data {
					pins = "gpio4", "gpio5";
					function = "swr_rx_data";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-bus-hold;
				};
			};

			tx_swr-active-pins {
				phandle = <0xe9>;

				clk {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-disable;
				};

				data {
					pins = "gpio1", "gpio2", "gpio14";
					function = "swr_tx_data";
					drive-strength = <0x0a>;
					slew-rate = <0x03>;
					bias-bus-hold;
				};
			};
		};

		sound {
			compatible = "qcom,sm7125-sndcard";
			pinctrl-0 = <0xec>;
			pinctrl-names = "default";
			audio-routing = "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "AMIC1", "MIC BIAS1", "AMIC2", "MIC BIAS2", "AMIC4", "MIC BIAS3", "TX SWR_ADC0", "ADC1_OUTPUT", "TX SWR_ADC1", "ADC2_OUTPUT", "TX SWR_ADC3", "ADC4_OUTPUT";
			model = "Galaxy A52";

			mm1-dai-link {
				link-name = "MultiMedia1";

				cpu {
					sound-dai = <0xed 0x00>;
				};
			};

			mm2-dai-link {
				link-name = "MultiMedia2";

				cpu {
					sound-dai = <0xed 0x01>;
				};
			};

			mm3-dai-link {
				link-name = "MultiMedia3";

				cpu {
					sound-dai = <0xed 0x02>;
				};
			};

			i2s-dai-link {
				link-name = "I2S Playback";

				cpu {
					sound-dai = <0xee 0x7f>;
				};

				platform {
					sound-dai = <0xef>;
				};

				codec {
					sound-dai = <0xf0 0xf1>;
				};
			};

			wcd-playback-dai-link {
				link-name = "WCD Playback";

				cpu {
					sound-dai = <0xee 0x71>;
				};

				codec {
					sound-dai = <0xf2 0x00 0xf3 0x00 0xe8 0x00>;
				};

				platform {
					sound-dai = <0xef>;
				};
			};

			wcd-capture-dai-link {
				link-name = "WCD Capture";

				cpu {
					sound-dai = <0xee 0x78>;
				};

				codec {
					sound-dai = <0xf2 0x01 0xf4 0x00 0xea 0x00>;
				};

				platform {
					sound-dai = <0xef>;
				};
			};
		};

		remoteproc@8300000 {
			compatible = "qcom,sm7125-cdsp-pas", "qcom,sm6350-cdsp-pas";
			reg = <0x00 0x8300000 0x00 0x10000>;
			interrupts-extended = <0x01 0x00 0x242 0x04 0xf5 0x00 0x01 0xf5 0x01 0x01 0xf5 0x02 0x01 0xf5 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x2f 0x00>;
			clock-names = "xo";
			power-domains = <0x31 0x00 0x31 0x03>;
			power-domain-names = "cx", "mx";
			memory-region = <0xf6>;
			qcom,qmp = <0x76>;
			qcom,smem-states = <0xf7 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			firmware-name = "qcom/sm7125/a52q/cdsp.mbn";

			glink-edge {
				interrupts = <0x00 0x23e 0x01>;
				label = "cdsp";
				qcom,remote-pid = <0x05>;
				mboxes = <0x2e 0x04>;

				fastrpc {
					compatible = "qcom,fastrpc";
					qcom,glink-channels = "fastrpcglink-apps-dsp";
					label = "cdsp";
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					compute-cb@1 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x01>;
						iommus = <0x34 0x1401 0x20>;
					};

					compute-cb@2 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x02>;
						iommus = <0x34 0x1402 0x20>;
					};

					compute-cb@3 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x03>;
						iommus = <0x34 0x1403 0x20>;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x04>;
						iommus = <0x34 0x1404 0x20>;
					};

					compute-cb@5 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x05>;
						iommus = <0x34 0x1405 0x20>;
					};

					compute-cb@6 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x06>;
						iommus = <0x34 0x1406 0x20>;
					};

					compute-cb@7 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x07>;
						iommus = <0x34 0x1407 0x20>;
					};

					compute-cb@8 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x08>;
						iommus = <0x34 0x1408 0x20>;
					};
				};
			};
		};

		dma-controller@800000 {
			compatible = "qcom,sm7125-gpi-dma", "qcom,sm6350-gpi-dma";
			reg = <0x00 0x800000 0x00 0x60000>;
			interrupts = <0x00 0xf4 0x04 0x00 0xf5 0x04 0x00 0xf6 0x04 0x00 0xf7 0x04 0x00 0xf8 0x04 0x00 0xf9 0x04 0x00 0xfa 0x04 0x00 0xfb 0x04 0x00 0xfc 0x04 0x00 0xfd 0x04>;
			dma-channels = <0x0a>;
			dma-channel-mask = <0x1f>;
			iommus = <0x34 0x56 0x00>;
			#dma-cells = <0x03>;
			status = "okay";
		};

		dma-controller@a00000 {
			compatible = "qcom,sm7125-gpi-dma", "qcom,sm6350-gpi-dma";
			reg = <0x00 0xa00000 0x00 0x60000>;
			interrupts = <0x00 0x285 0x04 0x00 0x286 0x04 0x00 0x287 0x04 0x00 0x288 0x04 0x00 0x289 0x04 0x00 0x28a 0x04 0x00 0x28b 0x04 0x00 0x28c 0x04 0x00 0x28d 0x04 0x00 0x28e 0x04>;
			dma-channels = <0x0a>;
			dma-channel-mask = <0x3f>;
			iommus = <0x34 0x4d6 0x00>;
			#dma-cells = <0x03>;
			status = "okay";
			phandle = <0x5a>;
		};

		i2c-18 {
			compatible = "i2c-gpio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			sda-gpios = <0x48 0x58 0x06>;
			scl-gpios = <0x48 0x59 0x06>;
			pinctrl-names = "default";
			pinctrl-0 = <0xf8>;
			i2c-gpio,delay-us = <0x02>;

			codec@4c {
				compatible = "ti,tas2562";
				reg = <0x4c>;
				#sound-dai-cells = <0x00>;
				interrupt-parent = <0x48>;
				interrupts = <0x5a 0x00>;
				shutdown-gpios = <0x48 0x5e 0x00>;
				sound-name-prefix = "Right";
				ti,vmon-slot-no = <0x01>;
				ti,imon-slot-no = <0x00>;
				phandle = <0xf0>;
			};

			codec@4d {
				compatible = "ti,tas2562";
				reg = <0x4d>;
				#sound-dai-cells = <0x00>;
				interrupt-parent = <0x48>;
				interrupts = <0x5a 0x00>;
				shutdown-gpios = <0x48 0x5e 0x00>;
				sound-name-prefix = "Left";
				ti,vmon-slot-no = <0x01>;
				ti,imon-slot-no = <0x00>;
				phandle = <0xf1>;
			};
		};
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0xf9 0x01>;
			sustainable-power = <0x41c>;

			trips {

				trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xfa>;
				};

				trip-point1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xfb>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xfa>;
					cooling-device = <0x19 0xffffffff 0xffffffff 0x1a 0xffffffff 0xffffffff 0x1b 0xffffffff 0xffffffff 0x1c 0xffffffff 0xffffffff 0x1d 0xffffffff 0xffffffff 0x1e 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0xfb>;
