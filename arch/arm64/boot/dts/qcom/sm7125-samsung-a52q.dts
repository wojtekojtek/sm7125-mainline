		remoteproc@4080000 {
			compatible = "qcom,sc7180-mpss-pas";
			reg = <0x00 0x4080000 0x00 0x4040>;
			interrupts-extended = <0x01 0x00 0x10a 0x01 0x7a 0x00 0x01 0x7a 0x01 0x01 0x7a 0x02 0x01 0x7a 0x03 0x01 0x7a 0x07 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
			clocks = <0x2f 0x00>;
			clock-names = "xo";
			power-domains = <0x31 0x00 0x31 0x03 0x31 0x07>;
			power-domain-names = "cx", "mx", "mss";
			memory-region = <0x7b>;
			qcom,qmp = <0x76>;
